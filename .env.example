# ─── Anthropic (features de IA: la guía, análisis del mes, recomendaciones) ───
# La ruta /api/claude usa esta key en el servidor; nunca se expone al navegador.
# Sin ella, la app funciona pero los botones de IA responden "no configurado".
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar (por defecto claude-sonnet-5).
CLAUDE_MODEL=claude-sonnet-5

# ─── Supabase (persistencia real entre días y dispositivos) ───
# Sin estas variables, la app cae a localStorage del navegador (solo ese equipo).
# Requiere activar "Anonymous sign-ins" en Supabase → Authentication → Providers.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
